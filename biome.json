{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/.svelte-kit", "!!**/build"]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"indentScriptAndStyle": true
		},
		"linter": {
			"enabled": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"complexity": {
				"useMaxParams": { "level": "error", "options": { "max": 7 } }
			},
			"correctness": {
				"noUnresolvedImports": "off",
				"useQwikValidLexicalScope": "off"
			},
			"style": {
				"noHexColors": "off",
				"noIncrementDecrement": "off",
				"noMagicNumbers": "off",
				"noTernary": "off",
				"useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } }
			},
			"suspicious": {
				"noEmptySource": { "level": "error", "options": { "allowComments": true } }
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/lib/components/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": { "filenameCases": ["PascalCase"] }
						}
					}
				}
			}
		},
		{
			"includes": ["src/lib/components/Scene.svelte", "src/lib/iso.ts"],
			"linter": {
				"rules": {
					"complexity": { "noExcessiveLinesPerFunction": "off" },
					"style": { "noExcessiveLinesPerFile": "off" }
				}
			}
		},
		{
			"includes": ["src/app.d.ts"],
			"linter": { "rules": { "style": { "noNamespace": "off" } } }
		},
		{
			"includes": ["vite.config.ts"],
			"linter": { "rules": { "style": { "noDefaultExport": "off" } } }
		},
		{
			"includes": ["src/lib/sprites.ts"],
			"linter": { "rules": { "style": { "useNamingConvention": "off" } } }
		},
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
